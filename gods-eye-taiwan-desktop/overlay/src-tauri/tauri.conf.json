{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "上帝之眼・台灣版",
  "version": "0.1.0",
  "identifier": "tw.kuan.godseye",
  "build": {
    "beforeDevCommand": "npm run dev -- --strictPort",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "上帝之眼・台灣版",
        "width": 1280,
        "height": 800,
        "minWidth": 560,
        "minHeight": 440,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../../../vendor/whispercpp/bin/*.exe": "whispercpp/bin/",
      "../../../vendor/whispercpp/bin/*.dll": "whispercpp/bin/",
      "../../../vendor/whispercpp/ggml-tiny-q5_1.bin": "whispercpp/ggml-tiny-q5_1.bin",
      "../../../vendor/whispercpp/LICENSE": "whispercpp/LICENSE"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "installMode": "currentUser"
      }
    }
  }
}
