{
  "name": "gods-eye-taiwan-browser-overlay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25 || >=26 <27"
  },
  "scripts": {
    "install:browser": "node scripts/install-browser.mjs",
    "prepare:upstream": "node scripts/prepare-upstream.mjs",
    "prepare:win": "powershell -ExecutionPolicy Bypass -File scripts/prepare-upstream.ps1",
    "dev": "npm --prefix .work/upstream run dev",
    "build": "npm --prefix .work/upstream run build",
    "preview": "npm --prefix .work/upstream run preview",
    "start": "node scripts/start-gods-eye-browser.mjs",
    "check:boundaries": "npm --prefix .work/upstream run check:boundaries",
    "test:fare": "node --test tests/fare-engine.test.mjs",
    "test:assistant-transit": "node --test tests/assistant-transit-recovery.test.mjs tests/transit-recovery-panel.test.mjs",
    "test:transit-execution": "node --test tests/transit-execution.test.mjs tests/transit-recovery-panel.test.mjs tests/tdx-execution.test.mjs tests/transit-rail-corridor.test.mjs",
    "test:flight": "node --experimental-vm-modules --test tests/flight-observation.test.mjs",
    "test:transit-assistant": "node --test tests/transit-assistant-workflow.test.mjs"
  }
}
